[Unit]
Description=LLera AArel OS policy broker
After=local-fs.target
Before=mmonolith.service graphical.target

[Service]
Type=simple
ExecStart=/usr/lib/aarel/llerad.py
Restart=on-failure
RestartSec=2s
DynamicUser=yes
RuntimeDirectory=llera
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
