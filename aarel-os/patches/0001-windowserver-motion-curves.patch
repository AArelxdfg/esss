+float Animation::transformed_progress(float progress) const
+{
+    switch (m_curve) {
+    case AnimationCurve::Linear:
+        return progress;
+    case AnimationCurve::EaseOutCubic: {
+        auto inverse = 1.0f - progress;
+        return 1.0f - inverse * inverse * inverse;
+    }
+    case AnimationCurve::EaseInOutCubic:
+        if (progress < 0.5f)
+            return 4.0f * progress * progress * progress;
+        else {
+            auto inverse = -2.0f * progress + 2.0f;
+            return 1.0f - (inverse * inverse * inverse) / 2.0f;
+        }
+    case AnimationCurve::ForgeSpring: {
+        // Critically-damped-looking cubic response. This deliberately avoids
+        // overshoot so geometry and hit testing never disagree about bounds.
+        auto inverse = 1.0f - progress;
+        return 1.0f - inverse * inverse * (1.0f + 2.0f * progress);
+    }
+    }
+    VERIFY_NOT_REACHED();
+}
