#!/usr/bin/python3
import json
import os
import socket
import sys

operation = sys.argv[1] if len(sys.argv) > 1 else "status"
request = {"command": operation}
if operation == "authorize":
    if len(sys.argv) != 3:
        print("usage: lleractl authorize ACTION", file=sys.stderr)
        raise SystemExit(2)
    request["action"] = sys.argv[2]

try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(3)
        client.connect(os.environ.get("LLERA_SOCKET", "/run/llera/control.sock"))
        client.sendall(json.dumps(request).encode())
        response = json.loads(client.recv(65536))
except (OSError, ValueError) as error:
    print(json.dumps({"service": "LLera", "state": "error", "error": str(error)}))
    raise SystemExit(1)

print(json.dumps(response, indent=2, sort_keys=True))
raise SystemExit(0 if response.get("state") in {"running", "authorized"} else 1)
